{
  "name": "kigen",
  "version": "1.0.0",
  "description": "Template for a CLI using TypeScript",
  "keywords": [
    "cli",
    "typescript"
  ],
  "homepage": "https://github.com/codingcodax/kigen",
  "bugs": {
    "url": "https://github.com/codingcodax/kigen/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codingcodax/kigen.git"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Alexis Guzman",
    "url": "https://www.codingcodax.com"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "main": "index.js",
  "bin": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:silent": "tsdown --logLevel silent",
    "dev": "bunx tsx src/index.ts",
    "dev:node": "bun run build:silent && bun run start",
    "format": "bunx biome check --write src",
    "format:fix": "bunx biome check --write src",
    "lint": "bunx biome check src",
    "pub:beta": "bun run build && bun publish --access public --tag beta",
    "pub:next": "bun run build && bun publish --access public --tag next",
    "pub:release": "bun run build && bun publish --access public",
    "start": "bun dist/index.js",
    "test": "node --test tests/",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@clack/core": "^1.5.0",
    "@clack/prompts": "^1.8.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^22.20.2",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "ultracite": "^7.11.1"
  }
}

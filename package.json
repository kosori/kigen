{
  "name": "kigen",
  "version": "1.0.0",
  "description": "Template for a CLI using TypeScript",
  "keywords": [
    "cli",
    "typescript"
  ],
  "homepage": "https://github.com/codingcodax/kigen",
  "bugs": {
    "url": "https://github.com/codingcodax/kigen/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codingcodax/kigen.git"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Alexis Guzman",
    "url": "https://www.codingcodax.com"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "main": "dist/index.js",
  "bin": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:silent": "tsdown --logLevel silent",
    "check": "ultracite check",
    "dev": "tsx src/index.ts",
    "dev:node": "bun run build:silent && bun run start",
    "doctor": "ultracite doctor",
    "fix": "ultracite fix",
    "fix:unsafe": "ultracite fix --unsafe",
    "pub:beta": "bun run build && bun publish --access public --tag beta",
    "pub:next": "bun run build && bun publish --access public --tag next",
    "pub:release": "bun run build && bun publish --access public",
    "start": "node dist/index.js",
    "test": "bun run build:silent && node --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "ultracite": "^8.0.1"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24.11.0"
  }
}
